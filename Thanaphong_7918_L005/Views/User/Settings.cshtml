@model Thanaphong_7918_L005.Models.User
@{
    ViewData["Title"] = "ตั้งค่าบัญชี";
}

<div class="w-full max-w-4xl mx-auto">
    
    <!-- หัวข้อหน้า (ชิดซ้ายบนตามแบบเดิมของคุณ) -->
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-white">ตั้งค่า</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="max-w-xl mx-auto mb-6 bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="max-w-xl mx-auto mb-6 bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl">
            @TempData["Error"]
        </div>
    }

    <!-- ส่วนแสดงรูปโปรไฟล์ ชื่อ และอีเมล (จัดกึ่งกลาง + ดึงข้อมูลจริงจาก MySQL) -->
    <div class="flex flex-col items-center justify-center mb-10">
        
        <!-- กรอบรูปโปรไฟล์วงกลม -->
        <div class="relative group cursor-pointer mb-4">
            <div class="w-28 h-28 rounded-full bg-gradient-to-tr from-[#8B5CF6] to-indigo-500 p-1 shadow-lg">
                <div class="w-full h-full rounded-full bg-[#161823] flex items-center justify-center overflow-hidden">
                    <svg class="w-14 h-14 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                </div>
            </div>
            <div class="absolute bottom-0 right-0 bg-[#8B5CF6] text-white p-2 rounded-full border-2 border-[#11121A] shadow-md group-hover:bg-[#7C3AED] transition-colors" title="โปรไฟล์สมาชิก">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </div>
        </div>

        <!-- ชื่อผู้ใช้ อีเมล และแต้มสะสมจาก MySQL -->
        <h2 class="text-2xl font-bold text-white mb-1">@(Model?.Username ?? "ผู้ใช้งาน")</h2>
        <p class="text-gray-400 text-sm mb-2">@(Model?.Email ?? "-")</p>
        <span class="text-xs bg-purple-500/10 text-[#8B5CF6] border border-purple-500/30 px-3 py-1 rounded-full font-semibold">
            แต้มสะสม: @(Model?.Points ?? 0) แต้ม
        </span>
    </div>

    <!-- กล่องตั้งค่าบัญชี (ตรงกลาง - ดีไซน์เดิมของคุณ) -->
    <div class="max-w-xl mx-auto bg-[#161823] border border-gray-800 rounded-2xl p-6 shadow-lg space-y-4">
        
        <h3 class="text-lg font-bold text-white mb-2 px-2">ตั้งค่าบัญชี</h3>

        <div class="space-y-2">
            <!-- เมนูย่อย 1: ความปลอดภัย (กดเพื่อเปิดฟอร์มเปลี่ยนรหัสผ่าน) -->
            <button type="button" onclick="toggleSection('securitySection')" class="w-full text-left flex items-center justify-between p-4 rounded-xl hover:bg-[#1f2233] transition-colors group">
                <div class="flex items-center gap-4">
                    <div class="p-2.5 bg-purple-500/10 text-[#8B5CF6] rounded-lg group-hover:bg-[#8B5CF6] group-hover:text-white transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                    <div>
                        <div class="font-medium text-white">ความปลอดภัย</div>
                        <div class="text-xs text-gray-400">เปลี่ยนรหัสผ่าน และจัดการการเข้าสู่ระบบ</div>
                    </div>
                </div>
                <svg class="w-5 h-5 text-gray-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>

            <!-- กล่องฟอร์มเปลี่ยนรหัสผ่าน (ซ่อนไว้ กดเมนูด้านบนเพื่อเปิด) -->
            <div id="securitySection" class="hidden bg-[#11121A] border border-gray-800 rounded-xl p-4 mx-2">
                <form method="post" asp-controller="User" asp-action="ChangePassword" class="space-y-3">
                    <div>
                        <label class="block text-xs text-gray-400 mb-1">รหัสผ่านปัจจุบัน</label>
                        <input type="password" name="currentPassword" required class="w-full bg-[#161823] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                    </div>
                    <div>
                        <label class="block text-xs text-gray-400 mb-1">รหัสผ่านใหม่</label>
                        <input type="password" name="newPassword" required class="w-full bg-[#161823] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                    </div>
                    <button type="submit" class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-bold py-2.5 rounded-xl text-sm transition-colors">
                        บันทึกรหัสผ่านใหม่
                    </button>
                </form>
            </div>

            <!-- เมนูย่อย 2: ข้อมูลส่วนตัว (กดเพื่อเปิดฟอร์มแก้ไขชื่อผู้ใช้) -->
            <button type="button" onclick="toggleSection('profileSection')" class="w-full text-left flex items-center justify-between p-4 rounded-xl hover:bg-[#1f2233] transition-colors group">
                <div class="flex items-center gap-4">
                    <div class="p-2.5 bg-purple-500/10 text-[#8B5CF6] rounded-lg group-hover:bg-[#8B5CF6] group-hover:text-white transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>
                    <div>
                        <div class="font-medium text-white">ข้อมูลส่วนตัว</div>
                        <div class="text-xs text-gray-400">แก้ไขชื่อที่แสดงผล (Username)</div>
                    </div>
                </div>
                <svg class="w-5 h-5 text-gray-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>

            <!-- กล่องฟอร์มแก้ไขข้อมูลส่วนตัว (ซ่อนไว้ กดเมนูด้านบนเพื่อเปิด) -->
            <div id="profileSection" class="hidden bg-[#11121A] border border-gray-800 rounded-xl p-4 mx-2">
                <form method="post" asp-controller="User" asp-action="UpdateProfile" class="space-y-3">
                    <div>
                        <label class="block text-xs text-gray-400 mb-1">อีเมล (ไม่สามารถแก้ไขได้)</label>
                        <input type="text" value="@Model?.Email" disabled class="w-full bg-[#161823] text-gray-500 text-sm border border-gray-800 rounded-xl px-4 py-2.5" />
                    </div>
                    <div>
                        <label class="block text-xs text-gray-400 mb-1">ชื่อที่แสดงผล (Username)</label>
                        <input type="text" name="username" value="@Model?.Username" required class="w-full bg-[#161823] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                    </div>
                    <button type="submit" class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-bold py-2.5 rounded-xl text-sm transition-colors">
                        บันทึกชื่อผู้ใช้งาน
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

<script>
    function toggleSection(sectionId) {
        const el = document.getElementById(sectionId);
        el.classList.toggle('hidden');
    }
</script>