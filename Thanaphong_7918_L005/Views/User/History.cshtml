@model IEnumerable<Thanaphong_7918_L005.Models.Order>
@{
    ViewData["Title"] = "ประวัติการทำรายการ";
}

<div class="w-full max-w-6xl mx-auto space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-white">ประวัติการทำรายการสั่งซื้อ</h1>
        <p class="text-sm text-gray-400">ติดตามสถานะการตรวจสอบสลิปและการเติมเกมของคุณแบบเรียลไทม์</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl">
            @TempData["Error"]
        </div>
    }

    <div class="bg-[#161823] border border-gray-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-[#11121A] text-gray-400 text-xs uppercase border-b border-gray-800">
                        <th class="py-4 px-5">รหัสออเดอร์</th>
                        <th class="py-4 px-5">เกม / แพ็กเกจ</th>
                        <th class="py-4 px-5">UID ผู้เล่น</th>
                        <th class="py-4 px-5">ยอดชำระ</th>
                        <th class="py-4 px-5">วันที่สั่งซื้อ</th>
                        <th class="py-4 px-5">สถานะ</th>
                        <th class="py-4 px-5 text-right">ช่วยเหลือ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800 text-sm">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-10 text-center text-gray-500">ยังไม่มีประวัติการสั่งซื้อ</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                            <tr class="hover:bg-[#1f2233]/50 transition-colors">
                                <td class="py-4 px-5 font-bold text-[#8B5CF6]">#ORD-@order.OrderId.ToString("D4")</td>
                                <td class="py-4 px-5">
                                    <div class="font-bold text-white">@order.Package?.Game?.GameName</div>
                                    <div class="text-xs text-gray-400">@order.Package?.PackageName</div>
                                </td>
                                <td class="py-4 px-5 text-gray-200 font-mono">
                                    @order.GameUid @(string.IsNullOrEmpty(order.GameServer) ? "" : $"({order.GameServer})")
                                </td>
                                <td class="py-4 px-5 font-bold text-white">฿@order.TotalPrice.ToString("N2")</td>
                                <td class="py-4 px-5 text-gray-400 text-xs">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="py-4 px-5">
                                    @switch (order.Status)
                                    {
                                        case "PendingPayment":
                                            <span class="px-3 py-1 text-xs rounded-full bg-yellow-500/10 text-yellow-400 border border-yellow-500/20">⏳ รอตรวจสลิป</span>
                                            break;
                                        case "Paid":
                                            <span class="px-3 py-1 text-xs rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20">⚡ กำลังดำเนินการเติม</span>
                                            break;
                                        case "Completed":
                                            <span class="px-3 py-1 text-xs rounded-full bg-green-500/10 text-green-400 border border-green-500/20">✔ เติมสำเร็จ</span>
                                            break;
                                        case "Rejected":
                                            <span class="px-3 py-1 text-xs rounded-full bg-red-500/10 text-red-400 border border-red-500/20">✖ ยกเลิก / สลิปไม่ผ่าน</span>
                                            break;
                                        case "Refunded":
                                            <span class="px-3 py-1 text-xs rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20">↩ คืนเงินเรียบร้อยแล้ว</span>
                                            break;
                                        default:
                                            <span class="px-3 py-1 text-xs rounded-full bg-gray-500/10 text-gray-400">@order.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="py-4 px-5 text-right">
                                    @if (order.Status != "Completed" && order.Status != "Refunded")
                                    {
                                        <button type="button" onclick="openRefundModal(@order.OrderId)"
                                                class="text-xs bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white border border-red-500/30 px-3 py-1.5 rounded-lg transition-colors">
                                            ขอคืนเงิน
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-600">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal ยื่นคำร้องขอคืนเงิน -->
<div id="refundModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#161823] border border-gray-700 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
        <div class="flex justify-between items-center border-b border-gray-800 pb-3">
            <h3 class="text-lg font-bold text-white">ยื่นคำร้องขอคืนเงิน <span id="refundOrderLabel" class="text-[#8B5CF6]"></span></h3>
            <button type="button" onclick="document.getElementById('refundModal').classList.add('hidden')" class="text-gray-400 hover:text-white text-2xl">&times;</button>
        </div>

        <form method="post" asp-controller="User" asp-action="RequestRefund" class="space-y-4">
            <input type="hidden" name="orderId" id="refundOrderId" value="0" />
            <div>
                <label class="block text-sm text-gray-300 mb-1.5">ระบุเหตุผลและเลขบัญชีรับเงินคืน *</label>
                <textarea name="reason" rows="3" required placeholder="เช่น กรอก UID ผิด / โอนเงินเกิน (พร้อมเลขบัญชีรับโอนคืน)"
                          class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl p-3 focus:outline-none focus:border-[#8B5CF6]"></textarea>
            </div>
            <button type="submit" class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-bold py-2.5 rounded-xl shadow">
                ส่งคำร้องให้ฝ่ายบัญชี
            </button>
        </form>
    </div>
</div>

<script>
    function openRefundModal(orderId) {
        document.getElementById('refundOrderId').value = orderId;
        document.getElementById('refundOrderLabel').textContent = '#ORD-' + String(orderId).padStart(4, '0');
        document.getElementById('refundModal').classList.remove('hidden');
    }
</script>