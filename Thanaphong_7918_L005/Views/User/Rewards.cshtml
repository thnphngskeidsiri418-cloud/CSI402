@model Thanaphong_7918_L005.Models.User
@{
    ViewData["Title"] = "หน้ารางวัล";
    // คำนวณมูลค่าแต้ม (สมมติ 1 แต้ม = 1 บาท)
    decimal pointValue = Model?.Points ?? 0;
}

<div class="w-full flex flex-col md:flex-row gap-8">
    
    <!-- หัวข้อหน้า (ฝั่งซ้าย - ของเดิมคุณ) -->
    <div class="md:w-1/4">
        <h1 class="text-2xl font-bold text-white">หน้ารางวัล</h1>
    </div>

    <!-- ส่วนเนื้อหาตรงกลาง (กล่องรางวัล + รายการแลกรางวัล) -->
    <div class="md:w-3/4 max-w-3xl space-y-8">
        
        @if (TempData["Success"] != null)
        {
            <div class="bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl">
                @TempData["Error"]
            </div>
        }

        <!-- กล่องแสดงแต้มรางวัล (ดีไซน์เดิมของคุณ + ดึงแต้มจริงจาก MySQL) -->
        <div class="bg-[#161823] border border-gray-700 rounded-xl overflow-hidden shadow-md">
            <!-- ส่วนหัวกล่อง -->
            <div class="px-6 py-4 border-b border-gray-700 flex justify-between items-center">
                <h2 class="text-lg font-medium text-gray-300">รางวัลรวม</h2>
                <span class="text-xs text-gray-400">บัญชี: <span class="text-white font-semibold">@Model?.Username</span></span>
            </div>
            <!-- ส่วนตัวเลขแต้ม -->
            <div class="px-6 py-12">
                <p class="text-4xl font-bold text-white">
                    @(Model?.Points ?? 0) <span class="text-2xl font-normal text-gray-400 ml-2">(มูลค่า ฿@pointValue.ToString("N2"))</span>
                </p>
            </div>
        </div>

        <!-- ส่วนแลกของรางวัล (เพิ่มต่อท้ายเพื่อให้กดใช้แต้มได้จริง) -->
        <div class="space-y-4">
            <h3 class="text-lg font-semibold text-white">แลกของรางวัล</h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                
                <!-- รางวัลที่ 1 -->
                <div class="bg-[#161823] border border-gray-800 hover:border-[#8B5CF6] rounded-xl p-5 flex flex-col justify-between space-y-4 transition-all">
                    <div>
                        <span class="text-xs bg-purple-500/20 text-[#8B5CF6] px-2.5 py-1 rounded-full font-bold">ใช้ 10 แต้ม</span>
                        <h4 class="text-base font-bold text-white mt-3">คูปองส่วนลด 20 บาท</h4>
                        <p class="text-xs text-gray-400 mt-1">ใช้ลดราคาเมื่อเติมเกมครั้งถัดไป</p>
                    </div>
                    <form method="post" asp-controller="User" asp-action="RedeemReward">
                        <input type="hidden" name="pointsRequired" value="10" />
                        <input type="hidden" name="rewardName" value="คูปองส่วนลด 20 บาท" />
                        <button type="submit" class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-bold py-2 rounded-lg text-xs transition-colors">
                            แลกรางวัล
                        </button>
                    </form>
                </div>

                <!-- รางวัลที่ 2 -->
                <div class="bg-[#161823] border border-gray-800 hover:border-[#8B5CF6] rounded-xl p-5 flex flex-col justify-between space-y-4 transition-all">
                    <div>
                        <span class="text-xs bg-purple-500/20 text-[#8B5CF6] px-2.5 py-1 rounded-full font-bold">ใช้ 50 แต้ม</span>
                        <h4 class="text-base font-bold text-white mt-3">บัตรเติมเงิน 100 บาท</h4>
                        <p class="text-xs text-gray-400 mt-1">รับโค้ดเติมเกมมูลค่า 100 บาททันที</p>
                    </div>
                    <form method="post" asp-controller="User" asp-action="RedeemReward">
                        <input type="hidden" name="pointsRequired" value="50" />
                        <input type="hidden" name="rewardName" value="บัตรเติมเงิน 100 บาท" />
                        <button type="submit" class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-bold py-2 rounded-lg text-xs transition-colors">
                            แลกรางวัล
                        </button>
                    </form>
                </div>

                <!-- รางวัลที่ 3 -->
                <div class="bg-[#161823] border border-gray-800 hover:border-[#8B5CF6] rounded-xl p-5 flex flex-col justify-between space-y-4 transition-all">
                    <div>
                        <span class="text-xs bg-purple-500/20 text-[#8B5CF6] px-2.5 py-1 rounded-full font-bold">ใช้ 100 แต้ม</span>
                        <h4 class="text-base font-bold text-white mt-3">แพ็กเกจสุ่มไอเทมแรร์</h4>
                        <p class="text-xs text-gray-400 mt-1">ลุ้นรับคูปองสูงสุด 1,000 คูปอง</p>
                    </div>
                    <form method="post" asp-controller="User" asp-action="RedeemReward">
                        <input type="hidden" name="pointsRequired" value="100" />
                        <input type="hidden" name="rewardName" value="แพ็กเกจสุ่มไอเทมแรร์" />
                        <button type="submit" class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-bold py-2 rounded-lg text-xs transition-colors">
                            แลกรางวัล
                        </button>
                    </form>
                </div>

            </div>
        </div>

        <!-- คำอธิบายเพิ่มเติมด้านล่าง (ของเดิมคุณ) -->
        <div class="text-gray-300 space-y-2 px-2 pt-2 border-t border-gray-800">
            <h3 class="text-lg font-semibold text-white">เกี่ยวกับรางวัล</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
                ทุกการเติมเกมครบ 10 บาท คุณจะได้รับ 1 แต้มสะสมโดยอัตโนมัติทันทีที่พนักงานดำเนินการเติมเกมสำเร็จ สามารถนำแต้มสะสมมาแลกเป็นคูปองส่วนลดและของรางวัลพิเศษได้ตลอดเวลา
            </p>
        </div>

    </div>
</div>