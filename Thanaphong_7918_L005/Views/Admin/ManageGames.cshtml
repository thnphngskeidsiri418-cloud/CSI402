@model IEnumerable<Thanaphong_7918_L005.Models.Game>
@using System.Text.Json
@{
    ViewData["Title"] = "จัดการเกม - แอดมิน";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<div class="w-full max-w-7xl mx-auto space-y-6">
    
    <!-- ================= แถบเมนู 4 ปุ่มด้านบน ================= -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/Admin/Index" class="bg-[#161823] hover:bg-[#1f2233] text-gray-300 border border-gray-700 text-center py-3 rounded-full font-bold transition-all">
            ภาพรวม/สต็อก
        </a>
        <a href="/Admin/ManageGames" class="bg-[#8B5CF6] text-white text-center py-3 rounded-full font-bold shadow-md transition-all">
            จัดการเกม
        </a>
        <a href="/Admin/Promotions" class="bg-[#161823] hover:bg-[#1f2233] text-gray-300 border border-gray-700 text-center py-3 rounded-full font-bold transition-all">
            จัดการโปรโมชั่น
        </a>
        <a href="/Admin/Permissions" class="bg-[#161823] hover:bg-[#1f2233] text-gray-300 border border-gray-700 text-center py-3 rounded-full font-bold transition-all">
            จัดการสิทธิ์
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl">
            @TempData["Error"]
        </div>
    }

    <!-- ================= กล่องที่ 1: เลือกเกมในระบบเพื่อแก้ไข (ดึงจริงจาก MySQL) ================= -->
    <div class="bg-[#161823] border border-gray-800 rounded-2xl p-6 shadow-lg">
        <div class="flex justify-between items-center mb-4">
            <div>
                <h2 class="text-lg font-bold text-white">เลือกเกมในระบบเพื่อแก้ไข (@(Model?.Count() ?? 0))</h2>
                <p class="text-xs text-gray-400">คลิกที่การ์ดเกมด้านล่างเพื่อแก้ไขข้อมูลและแพ็กเกจ หรือกดปุ่มเพิ่มเกมใหม่</p>
            </div>
            <button type="button" onclick="resetGameForm()" class="bg-[#8B5CF6] hover:bg-[#7C3AED] text-white text-xs px-4 py-2 rounded-lg font-bold transition-colors">
                + เพิ่มเกมใหม่
            </button>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-6 text-gray-500 text-sm border border-dashed border-gray-800 rounded-xl">
                ยังไม่มีเกมในฐานข้อมูล MySQL กรอกฟอร์มด้านล่างเพื่อเพิ่มเกมแรกได้เลยครับ
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                @foreach (var g in Model)
                {
                    var pkgJson = JsonSerializer.Serialize(g.Packages.Select(p => new {
                        name = p.PackageName,
                        price = p.Price,
                        amount = p.ItemAmount
                    }));

                    <div onclick='editGame(@g.GameId, @Html.Raw(JsonSerializer.Serialize(g.GameName)), @(g.IsActive == true ? "true" : "false"), @Html.Raw(pkgJson))'
                         class="p-4 rounded-xl bg-[#11121A] hover:bg-[#1f2233] border border-gray-800 hover:border-[#8B5CF6] cursor-pointer transition-all flex items-center gap-3.5">
                        <img src="@g.CoverImage" alt="@g.GameName"
                             onerror="this.src='https://placehold.co/100x100/161823/8B5CF6?text=GAME'"
                             class="w-12 h-12 rounded-xl object-cover bg-gray-800 shrink-0" />
                        <div class="min-w-0">
                            <div class="font-bold text-white text-sm truncate">@g.GameName</div>
                            <div class="text-xs mt-0.5 @(g.IsActive == true ? "text-green-400" : "text-red-400")">
                                ● @(g.IsActive == true ? "เปิดใช้งาน" : "ปิดปรับปรุง")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ================= กล่องที่ 2: ฟอร์มเพิ่ม / แก้ไขข้อมูลเกมและแพ็กเกจ ================= -->
    <div class="bg-[#161823] border border-gray-800 rounded-2xl p-6 shadow-lg">
        <div class="flex justify-between items-center mb-5 pb-3 border-b border-gray-800">
            <h2 id="gameFormTitle" class="text-lg font-bold text-[#8B5CF6]">เพิ่มข้อมูลเกมใหม่</h2>

            <form id="deleteGameForm" method="post" asp-controller="Admin" asp-action="DeleteGame" onsubmit="return confirm('ยืนยันการลบเกมและแพ็กเกจทั้งหมดของเกมนี้?');" class="hidden">
                <input type="hidden" name="gameId" id="deleteGameId" value="0" />
                <button type="submit" class="text-xs bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white border border-red-500/30 px-3.5 py-1.5 rounded-lg transition-colors">
                    ลบเกมนี้
                </button>
            </form>
        </div>

        <form method="post" asp-controller="Admin" asp-action="SaveGame" enctype="multipart/form-data" class="space-y-6">
            <input type="hidden" name="gameId" id="gameIdInput" value="0" />

            <!-- แถวที่ 1: ชื่อเกม / รูปแบบข้อมูลที่ลูกค้าต้องกรอก / สถานะการแสดงผล -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs text-gray-400 mb-1.5">ชื่อเกม *</label>
                    <input type="text" name="gameName" id="gameNameInput" required placeholder="ระบุชื่อเกม..."
                           class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                </div>

                <div>
                    <label class="block text-xs text-gray-400 mb-1.5">รูปแบบข้อมูลที่ลูกค้าต้องกรอก</label>
                    <input type="text" name="inputFormat" id="inputFormatInput" placeholder="เช่น OpenID, UID, Riot ID"
                           class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                </div>

                <div>
                    <label class="block text-xs text-gray-400 mb-1.5">สถานะการแสดงผล</label>
                    <select name="isActive" id="gameStatusInput" class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]">
                        <option value="true">เปิดใช้งาน (แสดงหน้าเว็บ)</option>
                        <option value="false">ปิดปรับปรุง (ซ่อนจากหน้าเว็บ)</option>
                    </select>
                </div>
            </div>

            <!-- แถวที่ 2: คำอธิบาย / วิธีดูเลข ID และ อัปโหลดรูปปกเกม -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs text-gray-400 mb-1.5">คำอธิบาย / วิธีดูเลข ID</label>
                    <textarea name="description" id="descriptionInput" rows="2" placeholder="อธิบายวิธีการเติมเงินหรือวิธีหาเลข UID ของเกมนี้..."
                              class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]"></textarea>
                </div>

                <div>
                    <label class="block text-xs text-gray-400 mb-1.5">อัปโหลดรูปไอคอน / แบนเนอร์เกม</label>
                    <input type="file" name="coverFile" accept="image/*"
                           class="w-full bg-[#11121A] text-gray-400 text-xs border border-gray-700 rounded-xl px-3 py-3 file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#8B5CF6] file:text-white hover:file:bg-[#7C3AED]" />
                </div>
            </div>

            <!-- รายการแพ็กเกจเติมเงิน -->
            <div class="space-y-3 pt-2 border-t border-gray-800">
                <div class="flex justify-between items-center">
                    <label class="text-sm font-bold text-white">รายการแพ็กเกจเติมเงิน</label>
                    <button type="button" onclick="addPackageRow()" class="text-xs bg-[#1f2233] hover:bg-[#8B5CF6] text-gray-200 hover:text-white border border-gray-700 px-3 py-1.5 rounded-lg transition-colors">
                        + เพิ่มแพ็กเกจใหม่
                    </button>
                </div>

                <div id="packageContainer" class="space-y-2.5">
                    <div class="grid grid-cols-12 gap-3 items-center package-row">
                        <div class="col-span-6">
                            <input type="text" name="packageNames" required placeholder="ชื่อแพ็กเกจ (เช่น 100 คูปอง)"
                                   class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                        </div>
                        <div class="col-span-3">
                            <input type="number" step="0.01" name="packagePrices" required placeholder="ราคา (บาท)"
                                   class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                        </div>
                        <div class="col-span-2">
                            <input type="number" name="packageAmounts" required placeholder="จำนวนหน่วย"
                                   class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                        </div>
                        <div class="col-span-1 text-center">
                            <button type="button" onclick="this.closest('.package-row').remove()" class="text-gray-500 hover:text-red-400 font-bold text-lg">&times;</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-gray-800 flex justify-end gap-3">
                <button type="button" onclick="resetGameForm()" class="px-5 py-2.5 rounded-xl text-sm text-gray-400 hover:text-white hover:bg-gray-800 transition-colors">
                    ยกเลิก / ล้างค่า
                </button>
                <button type="submit" class="bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-bold px-8 py-2.5 rounded-xl text-sm shadow-md transition-all">
                    บันทึกข้อมูลเกม
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function addPackageRow(name = '', price = '', amount = '') {
        const container = document.getElementById('packageContainer');
        const row = document.createElement('div');
        row.className = 'grid grid-cols-12 gap-3 items-center package-row';
        row.innerHTML = `
            <div class="col-span-6">
                <input type="text" name="packageNames" value="${name}" required placeholder="ชื่อแพ็กเกจ (เช่น 100 คูปอง)"
                       class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
            </div>
            <div class="col-span-3">
                <input type="number" step="0.01" name="packagePrices" value="${price}" required placeholder="ราคา (บาท)"
                       class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
            </div>
            <div class="col-span-2">
                <input type="number" name="packageAmounts" value="${amount}" required placeholder="จำนวนหน่วย"
                       class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
            </div>
            <div class="col-span-1 text-center">
                <button type="button" onclick="this.closest('.package-row').remove()" class="text-gray-500 hover:text-red-400 font-bold text-lg">&times;</button>
            </div>
        `;
        container.appendChild(row);
    }

    function editGame(id, name, isActive, packages) {
        document.getElementById('gameFormTitle').textContent = 'แก้ไขข้อมูลเกม: ' + name;
        document.getElementById('gameIdInput').value = id;
        document.getElementById('deleteGameId').value = id;
        document.getElementById('gameNameInput').value = name;
        document.getElementById('gameStatusInput').value = isActive ? 'true' : 'false';
        document.getElementById('deleteGameForm').classList.remove('hidden');

        const container = document.getElementById('packageContainer');
        container.innerHTML = '';
        if (packages && packages.length > 0) {
            packages.forEach(p => addPackageRow(p.name, p.price, p.amount));
        } else {
            addPackageRow();
        }
    }

    function resetGameForm() {
        document.getElementById('gameFormTitle').textContent = 'เพิ่มข้อมูลเกมใหม่';
        document.getElementById('gameIdInput').value = '0';
        document.getElementById('gameNameInput').value = '';
        document.getElementById('inputFormatInput').value = '';
        document.getElementById('descriptionInput').value = '';
        document.getElementById('gameStatusInput').value = 'true';
        document.getElementById('deleteGameForm').classList.add('hidden');

        const container = document.getElementById('packageContainer');
        container.innerHTML = '';
        addPackageRow();
    }
</script>