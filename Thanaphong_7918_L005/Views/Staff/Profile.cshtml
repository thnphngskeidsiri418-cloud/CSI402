@model Thanaphong_7918_L005.Models.User
@{
    ViewData["Title"] = "โปรไฟล์เจ้าหน้าที่";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<div class="w-full max-w-4xl mx-auto space-y-6">

    <!-- ปุ่มย้อนกลับตาม Role ของผู้ใช้ -->
    <div>
        @if (Model?.Role == "Admin")
        {
            <a href="/Admin/Index" class="text-sm text-gray-400 hover:text-white transition-colors">&larr; กลับหน้าภาพรวมแอดมิน</a>
        }
        else if (Model?.Role == "Accountant")
        {
            <a href="/Accountant/Index" class="text-sm text-gray-400 hover:text-white transition-colors">&larr; กลับหน้าฝ่ายบัญชี</a>
        }
        else
        {
            <a href="/Staff/Index" class="text-sm text-gray-400 hover:text-white transition-colors">&larr; กลับหน้าคิวเติมเกม</a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl">
            @TempData["Error"]
        </div>
    }

    <!-- การ์ดข้อมูลโปรไฟล์ -->
    <div class="bg-[#161823] border border-gray-800 rounded-2xl p-8 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-5">
            <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-[#8B5CF6] to-indigo-500 p-1 shadow-lg shrink-0">
                <div class="w-full h-full rounded-full bg-[#11121A] flex items-center justify-center text-2xl font-extrabold text-white">
                    @(Model?.Username?.Substring(0, 1).ToUpper() ?? "S")
                </div>
            </div>
            <div>
                <div class="flex items-center gap-3">
                    <h1 class="text-2xl font-bold text-white">@(Model?.Username ?? "-")</h1>
                    <span class="px-3 py-0.5 text-xs font-bold rounded-full bg-purple-500/20 text-[#8B5CF6] border border-purple-500/30">
                        @Model?.Role
                    </span>
                </div>
                <p class="text-sm text-gray-400 mt-1">@(Model?.Email ?? "-")</p>
                <p class="text-xs text-gray-500 mt-1">รหัสพนักงาน: #EMP-@((Model?.UserId ?? 0).ToString("D4"))</p>
            </div>
        </div>

        <a href="/Account/Logout" class="bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white border border-red-500/30 px-5 py-2.5 rounded-xl text-sm font-bold transition-all">
            ออกจากระบบ
        </a>
    </div>

    <!-- ฟอร์มแก้ไขชื่อผู้ใช้ และ เปลี่ยนรหัสผ่าน -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- กล่องซ้าย: แก้ไขชื่อที่แสดงผล -->
        <div class="bg-[#161823] border border-gray-800 rounded-2xl p-6 shadow-lg">
            <h2 class="text-lg font-bold text-white mb-4 pb-2 border-b border-gray-800">ข้อมูลบัญชี</h2>
            <form method="post" asp-controller="Staff" asp-action="UpdateProfile" class="space-y-4">
                <div>
                    <label class="block text-xs text-gray-400 mb-1.5">อีเมลเข้าสู่ระบบ</label>
                    <input type="text" value="@Model?.Email" disabled class="w-full bg-[#11121A] text-gray-500 text-sm border border-gray-800 rounded-xl px-4 py-2.5" />
                </div>
                <div>
                    <label class="block text-xs text-gray-300 mb-1.5">ชื่อผู้ใช้งาน (Username)</label>
                    <input type="text" name="username" value="@Model?.Username" required class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                </div>
                <button type="submit" class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-bold py-2.5 rounded-xl text-sm transition-colors">
                    บันทึกชื่อผู้ใช้งาน
                </button>
            </form>
        </div>

        <!-- กล่องขวา: เปลี่ยนรหัสผ่าน -->
        <div class="bg-[#161823] border border-gray-800 rounded-2xl p-6 shadow-lg">
            <h2 class="text-lg font-bold text-white mb-4 pb-2 border-b border-gray-800">เปลี่ยนรหัสผ่าน</h2>
            <form method="post" asp-controller="Staff" asp-action="ChangePassword" class="space-y-4">
                <div>
                    <label class="block text-xs text-gray-300 mb-1.5">รหัสผ่านปัจจุบัน</label>
                    <input type="password" name="currentPassword" required class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                </div>
                <div>
                    <label class="block text-xs text-gray-300 mb-1.5">รหัสผ่านใหม่</label>
                    <input type="password" name="newPassword" required class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                </div>
                <button type="submit" class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-bold py-2.5 rounded-xl text-sm transition-colors">
                    อัปเดตรหัสผ่านใหม่
                </button>
            </form>
        </div>

    </div>
</div>