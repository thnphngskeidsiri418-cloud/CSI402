@model IEnumerable<Thanaphong_7918_L005.Models.Game>
@using System.Text.Json
@{
    ViewData["Title"] = "จัดการเกม - พนักงาน";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    var firstGame = Model?.FirstOrDefault();
}

<div class="w-full max-w-7xl mx-auto">
    
    <!-- แถบเมนูสลับโหมดด้านบน (3 ปุ่ม: คิวเติมเกม / จัดการเกม / แชทช่วยเหลือลูกค้า) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <a href="/Staff/Index" class="bg-[#161823] hover:bg-[#1f2233] text-gray-300 border border-gray-700 text-center py-3 rounded-full font-bold transition-all">
            คิวเติมเกม
        </a>
        <a href="/Staff/ManageGames" class="bg-[#8B5CF6] text-white text-center py-3 rounded-full font-bold shadow-md transition-all">
            จัดการเกม
        </a>
        <a href="/Staff/SupportChat" class="bg-[#161823] hover:bg-[#1f2233] text-gray-300 border border-gray-700 text-center py-3 rounded-full font-bold transition-all">
            แชทช่วยเหลือลูกค้า
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl">
            @TempData["Error"]
        </div>
    }

    <!-- พื้นที่ทำงานหลัก แบ่ง 2 ฝั่ง -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- ================= ฝั่งซ้าย: รายการเกมในระบบจาก MySQL (5 คอลัมน์) ================= -->
        <div class="lg:col-span-5 bg-[#161823] border border-gray-800 rounded-2xl p-5 flex flex-col h-[calc(100vh-230px)] shadow-lg">
            
            <!-- หัวข้อ + ปุ่มเพิ่มเกมใหม่ -->
            <div class="flex justify-between items-center mb-4 pb-3 border-b border-gray-800">
                <h2 class="text-lg font-bold text-white">รายการเกมในระบบ (@(Model?.Count() ?? 0))</h2>
                <button type="button" onclick="resetToAddMode()" class="bg-[#8B5CF6] hover:bg-[#7C3AED] text-white text-xs px-3 py-2 rounded-lg font-semibold transition-colors">
                    + เพิ่มเกมใหม่
                </button>
            </div>

            <!-- ช่องค้นหาเกม -->
            <div class="mb-4">
                <input type="text" id="staffGameSearch" onkeyup="filterStaffGames()" placeholder="ค้นหาชื่อเกม..." 
                       class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
            </div>

            <!-- รายการเกม (ดึงจริงจากฐานข้อมูล MySQL) -->
            <div class="flex-grow overflow-y-auto space-y-3 pr-1">
                @if (Model == null || !Model.Any())
                {
                    <div class="text-center py-10 text-gray-500 text-sm">
                        ยังไม่มีเกมในฐานข้อมูล MySQL
                    </div>
                }
                else
                {
                    @foreach (var g in Model)
                    {
                        var isFirst = (firstGame != null && g.GameId == firstGame.GameId);
                        var cardStyle = isFirst ? "bg-[#1f2233] border-2 border-[#8B5CF6]" : "bg-[#11121A] hover:bg-[#1f2233] border border-gray-800 hover:border-[#8B5CF6]";
                        var pkgJson = JsonSerializer.Serialize(g.Packages.Select(p => new {
                            name = p.PackageName,
                            price = p.Price,
                            amount = p.ItemAmount
                        }));

                        <div onclick='selectGameToEdit(this, @g.GameId, @Html.Raw(JsonSerializer.Serialize(g.GameName)), @(g.IsActive == true ? "true" : "false"), @Html.Raw(pkgJson))'
                             data-name="@g.GameName.ToLower()"
                             class="staff-game-card p-3.5 rounded-xl @cardStyle cursor-pointer transition-all flex items-center justify-between group">
                            <div class="flex items-center gap-3 min-w-0">
                                <img src="@g.CoverImage" alt="@g.GameName"
                                     onerror="this.src='https://placehold.co/100x100/161823/8B5CF6?text=GAME'"
                                     class="w-12 h-12 rounded-lg object-cover bg-gray-800 shrink-0" />
                                <div class="min-w-0">
                                    <div class="font-bold text-white group-hover:text-[#8B5CF6] transition-colors truncate">@g.GameName</div>
                                    <div class="text-xs text-gray-400">@g.Packages.Count แพ็กเกจเติมเงิน</div>
                                </div>
                            </div>

                            @if (g.IsActive == true)
                            {
                                <span class="text-xs bg-green-500/10 text-green-400 border border-green-500/20 px-2.5 py-1 rounded-full shrink-0">
                                    เปิดใช้งาน
                                </span>
                            }
                            else
                            {
                                <span class="text-xs bg-red-500/10 text-red-400 border border-red-500/20 px-2.5 py-1 rounded-full shrink-0">
                                    ปิดปรับปรุง
                                </span>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ================= ฝั่งขวา: เพิ่มและแก้ไขข้อมูลเกม (7 คอลัมน์) ================= -->
        <div class="lg:col-span-7 bg-[#161823] border border-gray-800 rounded-2xl p-6 flex flex-col h-[calc(100vh-230px)] overflow-y-auto shadow-lg">
            
            <!-- หัวข้อฟอร์ม + ฟอร์มลบเกม -->
            <div class="flex justify-between items-center mb-5 pb-3 border-b border-gray-800">
                <h2 id="formTitle" class="text-lg font-bold text-white">
                    @(firstGame != null ? $"แก้ไขข้อมูลเกม: {firstGame.GameName}" : "เพิ่มข้อมูลเกมใหม่")
                </h2>

                <form id="deleteGameForm" method="post" asp-controller="Staff" asp-action="DeleteGame" onsubmit="return confirm('ยืนยันการลบเกมและแพ็กเกจทั้งหมดของเกมนี้?');" class="@(firstGame == null ? "hidden" : "")">
                    <input type="hidden" name="gameId" id="deleteGameId" value="@(firstGame?.GameId ?? 0)" />
                    <button type="submit" class="text-xs bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white border border-red-500/30 px-3 py-1.5 rounded-lg transition-colors">
                        ลบเกมนี้
                    </button>
                </form>
            </div>

            <!-- ฟอร์มกรอกข้อมูลเกม (ส่งเข้า StaffController/SaveGame) -->
            <form method="post" asp-controller="Staff" asp-action="SaveGame" enctype="multipart/form-data" class="space-y-4 flex-grow flex flex-col">
                <input type="hidden" name="gameId" id="gameIdInput" value="@(firstGame?.GameId ?? 0)" />
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- ชื่อเกม -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1.5">ชื่อเกม *</label>
                        <input type="text" name="gameName" id="gameNameInput" value="@(firstGame?.GameName ?? "")" required placeholder="เช่น ROV, Valorant" 
                               class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                    </div>

                    <!-- สถานะเกม -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1.5">สถานะการให้บริการ</label>
                        <select name="isActive" id="gameStatusInput" class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]">
                            @if (firstGame == null || firstGame.IsActive == true)
                            {
                                <option value="true" selected>เปิดใช้งาน (แสดงหน้าเว็บ)</option>
                                <option value="false">ปิดปรับปรุง (ซ่อนชั่วคราว)</option>
                            }
                            else
                            {
                                <option value="true">เปิดใช้งาน (แสดงหน้าเว็บ)</option>
                                <option value="false" selected>ปิดปรับปรุง (ซ่อนชั่วคราว)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- รูปแบบข้อมูลที่ลูกค้าต้องกรอก -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1.5">ข้อมูลที่ให้ลูกค้ากรอก</label>
                        <input type="text" name="inputFormat" id="gameInputType" placeholder="เช่น OpenID, UID, Riot ID" 
                               class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#8B5CF6]" />
                    </div>

                    <!-- อัปโหลดรูปปกเกม -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1.5">รูปปกเกม (URL หรือ อัปโหลด)</label>
                        <input type="file" name="coverFile" accept="image/*" 
                               class="w-full bg-[#11121A] text-gray-400 text-xs border border-gray-700 rounded-xl px-3 py-2 file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#8B5CF6] file:text-white hover:file:bg-[#7C3AED]" />
                    </div>
                </div>

                <!-- ส่วนจัดการแพ็กเกจราคาเติมเงินของเกมนี้ -->
                <div class="pt-3 border-t border-gray-800 flex-grow">
                    <div class="flex justify-between items-center mb-3">
                        <label class="text-sm font-bold text-white">แพ็กเกจเติมเงินในเกม</label>
                        <button type="button" onclick="addPackageRow()" class="text-xs text-[#8B5CF6] hover:text-purple-400 font-semibold">
                            + เพิ่มแพ็กเกจราคา
                        </button>
                    </div>

                    <!-- รายการแพ็กเกจ -->
                    <div id="packageList" class="space-y-2.5 max-h-48 overflow-y-auto pr-1">
                        @if (firstGame != null && firstGame.Packages.Any())
                        {
                            @foreach (var pkg in firstGame.Packages)
                            {
                                <div class="flex gap-2 items-center">
                                    <input type="text" name="packageNames" value="@pkg.PackageName" required placeholder="ชื่อแพ็กเกจ (เช่น 100 คูปอง)"
                                           class="flex-grow bg-[#11121A] text-white text-sm border border-gray-700 rounded-lg px-3 py-2 focus:outline-none focus:border-[#8B5CF6]" />
                                    <input type="number" step="0.01" name="packagePrices" value="@pkg.Price" required placeholder="ราคา (บาท)"
                                           class="w-28 bg-[#11121A] text-white text-sm border border-gray-700 rounded-lg px-3 py-2 focus:outline-none focus:border-[#8B5CF6]" />
                                    <input type="number" name="packageAmounts" value="@pkg.ItemAmount" required placeholder="จำนวน"
                                           class="w-24 bg-[#11121A] text-white text-sm border border-gray-700 rounded-lg px-3 py-2 focus:outline-none focus:border-[#8B5CF6]" />
                                    <button type="button" onclick="this.parentElement.remove()" class="p-2 text-gray-500 hover:text-red-400">
                                        &times;
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="flex gap-2 items-center">
                                <input type="text" name="packageNames" required placeholder="ชื่อแพ็กเกจ (เช่น 100 คูปอง)"
                                       class="flex-grow bg-[#11121A] text-white text-sm border border-gray-700 rounded-lg px-3 py-2 focus:outline-none focus:border-[#8B5CF6]" />
                                <input type="number" step="0.01" name="packagePrices" required placeholder="ราคา (บาท)"
                                       class="w-28 bg-[#11121A] text-white text-sm border border-gray-700 rounded-lg px-3 py-2 focus:outline-none focus:border-[#8B5CF6]" />
                                <input type="number" name="packageAmounts" required placeholder="จำนวน"
                                       class="w-24 bg-[#11121A] text-white text-sm border border-gray-700 rounded-lg px-3 py-2 focus:outline-none focus:border-[#8B5CF6]" />
                                <button type="button" onclick="this.parentElement.remove()" class="p-2 text-gray-500 hover:text-red-400">
                                    &times;
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- ปุ่มบันทึกข้อมูล (ด้านล่างสุด) -->
                <div class="pt-4 border-t border-gray-800 flex justify-end gap-3 mt-auto">
                    <button type="button" onclick="resetToAddMode()" class="px-5 py-2.5 rounded-xl text-sm font-medium text-gray-400 hover:text-white hover:bg-gray-800 transition-colors">
                        ล้างค่า
                    </button>
                    <button type="submit" class="bg-[#8B5CF6] hover:bg-[#7C3AED] text-white px-8 py-2.5 rounded-xl text-sm font-bold shadow-md transition-all">
                        บันทึกข้อมูลเกม
                    </button>
                </div>

            </form>
        </div>

    </div>
</div>

<!-- JavaScript สำหรับสลับโหมด เพิ่ม / แก้ไข และเพิ่มแถวแพ็กเกจ -->
<script>
    const formTitle = document.getElementById('formTitle');
    const gameIdInput = document.getElementById('gameIdInput');
    const deleteGameId = document.getElementById('deleteGameId');
    const gameNameInput = document.getElementById('gameNameInput');
    const gameInputType = document.getElementById('gameInputType');
    const gameStatusInput = document.getElementById('gameStatusInput');
    const deleteGameForm = document.getElementById('deleteGameForm');
    const packageList = document.getElementById('packageList');

    // เพิ่มแถวแพ็กเกจราคาใหม่
    function addPackageRow(name = '', price = '', amount = '') {
        const row = document.createElement('div');
        row.className = 'flex gap-2 items-center';
        row.innerHTML = `
            <input type="text" name="packageNames" value="${name}" required placeholder="ชื่อแพ็กเกจ (เช่น 100 คูปอง)" 
                   class="flex-grow bg-[#11121A] text-white text-sm border border-gray-700 rounded-lg px-3 py-2 focus:outline-none focus:border-[#8B5CF6]" />
            <input type="number" step="0.01" name="packagePrices" value="${price}" required placeholder="ราคา (บาท)" 
                   class="w-28 bg-[#11121A] text-white text-sm border border-gray-700 rounded-lg px-3 py-2 focus:outline-none focus:border-[#8B5CF6]" />
            <input type="number" name="packageAmounts" value="${amount}" required placeholder="จำนวน" 
                   class="w-24 bg-[#11121A] text-white text-sm border border-gray-700 rounded-lg px-3 py-2 focus:outline-none focus:border-[#8B5CF6]" />
            <button type="button" onclick="this.parentElement.remove()" class="p-2 text-gray-500 hover:text-red-400">
                &times;
            </button>
        `;
        packageList.appendChild(row);
    }

    // เมื่อคลิกเลือกเกมจากฝั่งซ้าย เพื่อแก้ไข
    function selectGameToEdit(element, id, name, isActive, packages) {
        document.querySelectorAll('.staff-game-card').forEach(c => {
            c.classList.remove('bg-[#1f2233]', 'border-2', 'border-[#8B5CF6]');
            c.classList.add('bg-[#11121A]', 'border', 'border-gray-800');
        });
        element.classList.remove('bg-[#11121A]', 'border', 'border-gray-800');
        element.classList.add('bg-[#1f2233]', 'border-2', 'border-[#8B5CF6]');

        formTitle.textContent = 'แก้ไขข้อมูลเกม: ' + name;
        gameIdInput.value = id;
        deleteGameId.value = id;
        gameNameInput.value = name;
        gameStatusInput.value = isActive ? 'true' : 'false';
        deleteGameForm.classList.remove('hidden');

        packageList.innerHTML = '';
        if (packages && packages.length > 0) {
            packages.forEach(p => addPackageRow(p.name, p.price, p.amount));
        } else {
            addPackageRow();
        }
    }

    // เมื่อกดปุ่ม "+ เพิ่มเกมใหม่" หรือ "ล้างค่า"
    function resetToAddMode() {
        formTitle.textContent = 'เพิ่มข้อมูลเกมใหม่';
        gameIdInput.value = '0';
        gameNameInput.value = '';
        gameInputType.value = '';
        gameStatusInput.value = 'true';
        deleteGameForm.classList.add('hidden');

        packageList.innerHTML = '';
        addPackageRow();
    }

    // ค้นหาเกมฝั่งซ้ายแบบเรียลไทม์
    function filterStaffGames() {
        const keyword = document.getElementById('staffGameSearch').value.toLowerCase();
        document.querySelectorAll('.staff-game-card').forEach(card => {
            const name = card.getAttribute('data-name');
            card.style.display = name.includes(keyword) ? 'flex' : 'none';
        });
    }
</script>