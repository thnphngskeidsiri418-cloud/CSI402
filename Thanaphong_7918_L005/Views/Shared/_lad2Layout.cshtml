<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Admin Dashboard | TopUpGame</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#0f111a] text-gray-200 font-sans antialiased min-h-screen flex">

    <!-- ================= ADMIN SIDEBAR ================= -->
    <aside class="w-64 bg-[#161926] border-r border-gray-800 flex flex-col justify-between shrink-0 hidden md:flex min-h-screen sticky top-0">
        <div>
            <!-- Admin Brand Logo -->
            <div class="h-16 flex items-center px-6 border-b border-gray-800 gap-3">
                <div class="p-2 bg-purple-600/20 text-purple-400 rounded-lg">
                    <i data-lucide="shield-alert" class="w-5 h-5"></i>
                </div>
                <span class="font-bold text-lg text-white tracking-wide">ADMIN<span class="text-purple-500">PANEL</span></span>
            </div>

            <!-- Navigation Links -->
            <nav class="p-4 space-y-1">
                <p class="px-3 text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Main Menu</p>
                
                <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-purple-600 text-white font-medium text-sm transition">
                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                    <span>แดชบอร์ด</span>
                </a>

                <a asp-controller="Admin" asp-action="Orders" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-gray-400 hover:bg-gray-800/60 hover:text-white font-medium text-sm transition">
                    <div class="flex items-center gap-3">
                        <i data-lucide="receipt" class="w-4 h-4"></i>
                        <span>รายการเติมเงิน</span>
                    </div>
                    <span class="bg-amber-500/20 text-amber-400 text-xs px-2 py-0.5 rounded-full font-bold">12</span>
                </a>

                <a asp-controller="Admin" asp-action="Games" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-400 hover:bg-gray-800/60 hover:text-white font-medium text-sm transition">
                    <i data-lucide="gamepad-2" class="w-4 h-4"></i>
                    <span>จัดการเกม & แพ็กเกจ</span>
                </a>

                <a asp-controller="Admin" asp-action="Users" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-400 hover:bg-gray-800/60 hover:text-white font-medium text-sm transition">
                    <i data-lucide="users" class="w-4 h-4"></i>
                    <span>จัดการผู้ใช้งาน</span>
                </a>

                <p class="px-3 text-[11px] font-semibold text-gray-500 uppercase tracking-wider mt-6 mb-2">System</p>

                <a asp-controller="Admin" asp-action="Settings" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-400 hover:bg-gray-800/60 hover:text-white font-medium text-sm transition">
                    <i data-lucide="settings" class="w-4 h-4"></i>
                    <span>ตั้งค่าระบบ / API</span>
                </a>
            </nav>
        </div>

        <!-- Sidebar Footer / Admin Info -->
        <div class="p-4 border-t border-gray-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-purple-600/30 border border-purple-500/50 flex items-center justify-center text-purple-300 font-bold text-xs">
                    AD
                </div>
                <div class="text-xs">
                    <p class="font-semibold text-white">Administrator</p>
                    <p class="text-gray-500">admin@topup.com</p>
                </div>
            </div>
            <a asp-controller="Account" asp-action="Logout" class="text-gray-400 hover:text-red-400 p-1 transition">
                <i data-lucide="log-out" class="w-4 h-4"></i>
            </a>
        </div>
    </aside>

    <!-- ================= MAIN CONTENT AREA ================= -->
    <div class="flex-1 flex flex-col min-w-0">

        <!-- Top Header -->
        <header class="h-16 bg-[#161926] border-b border-gray-800 px-6 flex items-center justify-between sticky top-0 z-20">
            <div class="flex items-center gap-4">
                <button class="md:hidden p-2 text-gray-400 hover:text-white">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
                <h1 class="text-lg font-bold text-white">@ViewData["Title"]</h1>
            </div>

            <div class="flex items-center gap-4">
                <!-- Search -->
                <div class="relative hidden sm:block">
                    <input type="text" placeholder="ค้นหา Order ID, UID..." class="bg-[#0f111a] border border-gray-700/60 rounded-lg text-xs py-2 pl-9 pr-4 text-gray-300 focus:outline-none focus:border-purple-500 w-60">
                    <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-2.5 text-gray-500"></i>
                </div>

                <!-- Back to Site Button -->
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-1.5 text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 px-3 py-2 rounded-lg border border-gray-700 transition">
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                    <span>ไปยังหน้าร้านค้า</span>
                </a>
            </div>
        </header>

        <!-- Body Render Section -->
        <main class="p-6 flex-1">
            @RenderBody()
        </main>

    </div>

    <script>
        lucide.createIcons();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>