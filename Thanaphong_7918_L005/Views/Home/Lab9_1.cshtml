@model IEnumerable<Thanaphong_7918_L005.Models.User>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>UserId</th>
            <th>Username</th>
            <th>PasswordHash</th>
            <th>Email</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UserId</td>
                <td>@item.Username</td>
                <td>@item.PasswordHash</td>
                <td>@item.Email</td>
                <td>@item.Role</td>
            </tr>
        }
    </tbody>
</table>