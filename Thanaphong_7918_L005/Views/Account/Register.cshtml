@{
    ViewData["Title"] = "สมัครสมาชิก";
}

<div class="min-h-[calc(100vh-200px)] flex items-center justify-center px-4">
    <div class="max-w-md w-full bg-[#161823] border border-gray-800 rounded-2xl p-8 shadow-xl">
        <h2 class="text-2xl font-bold text-white text-center mb-6">สมัครสมาชิกใหม่</h2>

        @if (ViewBag.Error != null)
        {
            <div class="bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl mb-4">
                @ViewBag.Error
            </div>
        }

        <form method="post" asp-controller="Account" asp-action="Register" class="space-y-4">
            <div>
                <label class="block text-sm text-gray-300 mb-1">ชื่อผู้ใช้ (Username)</label>
                <input type="text" name="username" required placeholder="กรอกชื่อผู้ใช้..."
                       class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-3 focus:outline-none focus:border-[#8B5CF6]" />
            </div>

            <div>
                <label class="block text-sm text-gray-300 mb-1">อีเมล (Email)</label>
                <input type="email" name="email" required placeholder="example@email.com"
                       class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-3 focus:outline-none focus:border-[#8B5CF6]" />
            </div>

            <div>
                <label class="block text-sm text-gray-300 mb-1">รหัสผ่าน (Password)</label>
                <input type="password" name="password" required placeholder="ตั้งรหัสผ่าน..."
                       class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-3 focus:outline-none focus:border-[#8B5CF6]" />
            </div>

            <div>
                <label class="block text-sm text-gray-300 mb-1">ยืนยันรหัสผ่าน</label>
                <input type="password" name="confirmPassword" required placeholder="กรอกรหัสผ่านอีกครั้ง..."
                       class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-3 focus:outline-none focus:border-[#8B5CF6]" />
            </div>

            <button type="submit" class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-bold py-3 rounded-xl shadow-md transition-all mt-2">
                สมัครสมาชิก
            </button>
        </form>

        <p class="text-center text-sm text-gray-400 mt-6">
            มีบัญชีอยู่แล้ว? <a href="/Account/Login" class="text-[#8B5CF6] hover:underline font-medium">เข้าสู่ระบบ</a>
        </p>
    </div>
</div>