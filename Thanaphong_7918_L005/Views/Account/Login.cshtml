@{
    ViewData["Title"] = "เข้าสู่ระบบ";
}

<div class="min-h-[calc(100vh-200px)] flex items-center justify-center px-4">
    <div class="max-w-md w-full bg-[#161823] border border-gray-800 rounded-2xl p-8 shadow-xl">
        <h2 class="text-2xl font-bold text-white text-center mb-6">เข้าสู่ระบบ</h2>

        @if (TempData["Success"] != null)
        {
            <div class="bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl mb-4">
                @TempData["Success"]
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl mb-4">
                @ViewBag.Error
            </div>
        }

        <form method="post" asp-controller="Account" asp-action="Login" class="space-y-4">
            <div>
                <label class="block text-sm text-gray-300 mb-1">อีเมล หรือ ชื่อผู้ใช้</label>
                <input type="text" name="email" required placeholder="กรอกอีเมลหรือชื่อผู้ใช้..."
                       class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-3 focus:outline-none focus:border-[#8B5CF6]" />
            </div>

            <div>
                <label class="block text-sm text-gray-300 mb-1">รหัสผ่าน</label>
                <input type="password" name="password" required placeholder="กรอกรหัสผ่าน..."
                       class="w-full bg-[#11121A] text-white text-sm border border-gray-700 rounded-xl px-4 py-3 focus:outline-none focus:border-[#8B5CF6]" />
            </div>

            <button type="submit" class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white font-bold py-3 rounded-xl shadow-md transition-all mt-2">
                เข้าสู่ระบบ
            </button>
        </form>

        <p class="text-center text-sm text-gray-400 mt-6">
            ยังไม่มีบัญชี? <a href="/Account/Register" class="text-[#8B5CF6] hover:underline font-medium">สมัครสมาชิก</a>
        </p>
    </div>
</div>