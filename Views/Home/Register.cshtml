@{
    ViewData["Title"] = "ลงทะเบียน";
    Layout = "_RegisterLayout";
}

<form asp-action="Register" method="post" class="space-y-4">
    <div>
        <input type="email" name="Email" placeholder="ใส่ Email ของคุณที่นี่" 
               class="w-full bg-[#0f111a] border border-gray-700 rounded-full py-3 px-4 text-center text-gray-200 placeholder-gray-500 focus:outline-none focus:border-purple-500 transition" required />
    </div>
    
    <div>
        <input type="text" name="Username" placeholder="ชื่อผู้ใช้ที่ทำการสั่งซื้อ" 
               class="w-full bg-[#0f111a] border border-gray-700 rounded-full py-3 px-4 text-center text-gray-200 placeholder-gray-500 focus:outline-none focus:border-purple-500 transition" required />
    </div>
    
    <div>
        <input type="password" name="Password" placeholder="ใส่รหัสผ่าน" 
               class="w-full bg-[#0f111a] border border-gray-700 rounded-full py-3 px-4 text-center text-gray-200 placeholder-gray-500 focus:outline-none focus:border-purple-500 transition" required />
    </div>
    
    <div class="pt-2">
        <button type="submit" 
                class="w-full bg-white hover:bg-gray-200 text-gray-900 font-bold py-3 rounded-full transition shadow-md">
            ต่อไป
        </button>
    </div>
</form>