@model IEnumerable<Thanaphong_7918_L005.Models.UserViewModel>

@{
    ViewData["Title"] = "รายชื่อผู้ใช้ในระบบ";
    Layout = "_RegisterLayout"; // หรือถ้าอยากให้แสดงเต็มจอ สามารถเปลี่ยนไปใช้ Layout หลักของเว็บได้ครับ
}

<div class="w-full max-w-4xl mx-auto py-6">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-white">รายชื่อผู้ใช้ในระบบ (User List)</h2>
        <a href="/Home/AddUser" class="bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition">
            + เพิ่มผู้ใช้ใหม่
        </a>
    </div>

    <div class="bg-[#161926] border border-gray-800 rounded-xl overflow-hidden shadow-2xl">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-800/50 text-gray-400 text-xs uppercase tracking-wider border-b border-gray-800">
                    <th class="py-3 px-4">ID</th>
                    <th class="py-3 px-4">Email</th>
                    <th class="py-3 px-4">Username</th>
                    <th class="py-3 px-4">Role</th>
                    <th class="py-3 px-4 text-center">จัดการ</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-800 text-sm text-gray-300">
                @foreach (var user in Model)
                {
                    <tr class="hover:bg-gray-800/30 transition">
                        <td class="py-3 px-4">@user.Id</td>
                        <td class="py-3 px-4">@user.Email</td>
                        <td class="py-3 px-4">@user.Username</td>
                        <td class="py-3 px-4">
                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold @(user.Role == "Admin" ? "bg-purple-500/20 text-purple-400 border border-purple-500/30" : "bg-blue-500/20 text-blue-400 border border-blue-500/30")">
                                @user.Role
                            </span>
                        </td>
                        <td class="py-3 px-4 text-center space-x-2">
                            <a href="#" class="text-amber-400 hover:underline text-xs">แก้ไข</a>
                            <a href="#" class="text-red-400 hover:underline text-xs">ลบ</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>